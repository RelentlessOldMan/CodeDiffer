<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeDiffer.Core\CodeDiffer.Core.csproj" />
    <!-- The MCP server and the CLI are tested too, so the tests target net10.0 like both exes (the CodeCompass
         model: CodeCompass.Core.Tests references CodeCompass.Mcp). Core itself stays net8.0. -->
    <ProjectReference Include="..\..\src\CodeDiffer.Mcp\CodeDiffer.Mcp.csproj" />
    <ProjectReference Include="..\..\src\CodeDiffer.Cli\CodeDiffer.Cli.csproj" />
  </ItemGroup>

</Project>
