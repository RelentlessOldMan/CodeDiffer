<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeDiffer.Core\CodeDiffer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10 to match the MCP server; both publish self-contained. Exe = CodeDiffer.Cli.exe (the CodeCompass
         model: CodeCompass.Cli.exe + CodeCompass.Mcp.exe, two exes over one Core; the command is still
         spoken of as `codediffer`). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeDiffer.Cli</RootNamespace>
  </PropertyGroup>

</Project>
