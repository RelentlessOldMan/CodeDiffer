<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the fleet floor (CodeCompass.Core, CodeCarver, CodeSpawner build from source on the
         work box's SDK). The CLI/MCP retarget to net10 on top of this. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeDiffer.Core</RootNamespace>
  </PropertyGroup>

  <!-- The test assembly reads internal canonicalization constants so a format tweak is tied to a test. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CodeDiffer.Tests" />
  </ItemGroup>

  <!-- XxHash128: the CodeCompass ledger hash (equality-only content hash, ~10x SHA-256 speed). -->
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <!-- The HTML report shell (static page; the data is written beside it). -->
  <ItemGroup>
    <EmbeddedResource Include="Report\report.html" LogicalName="CodeDiffer.Core.Report.report.html" />
  </ItemGroup>

</Project>
