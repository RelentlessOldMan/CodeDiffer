<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeDiffer.Core\CodeDiffer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Its own exe, CodeDiffer.Mcp.exe (stdio MCP server), like CodeCompass.Mcp.exe; net10 for the
         first-party .NET MCP SDK. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeDiffer.Mcp</RootNamespace>
  </PropertyGroup>

</Project>
