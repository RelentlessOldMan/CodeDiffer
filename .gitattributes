# Normalize line endings: LF in the repository, checked out natively.
* text=auto eol=lf

# Windows-specific text files keep CRLF.
*.sln text eol=crlf

# Shell scripts must stay LF — CRLF breaks the `#!/usr/bin/env bash` shebang under WSL/Linux.
*.sh text eol=lf

# Binary / index artifacts (belt-and-suspenders; these are gitignored anyway).
*.idx binary
*.bin binary

# A vendored CodeSpawner generator (native-AOT exe) must never be text/EOL-normalized.
tools/codespawner/*.exe binary
